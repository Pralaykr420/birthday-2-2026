# =============================================================================
#  Copy this file to `.env` and fill it in.
#
#    cp .env.example .env
#
#  `.env` is listed in .gitignore, so your secrets never get committed.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: the password for your private inbox at /#admin
# Must match `adminPassword` in
#   artifacts/omniscient-love/src/config/love.config.ts
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=pick-something-she-would-never-guess


# -----------------------------------------------------------------------------
# OPTIONAL: MongoDB
#
# Leave this out entirely and the server saves to a JSON file instead, which
# works perfectly and needs no setup at all.
#
# Add it when you want the data to survive the server restarting. A free
# MongoDB Atlas cluster takes about five minutes to create and the connection
# string looks like the line below. Remember to replace <password>, and to add
# 0.0.0.0/0 to the cluster's network access list so your host can reach it.
# -----------------------------------------------------------------------------
# MONGODB_URI=mongodb+srv://omniscient:<password>@cluster0.xxxxx.mongodb.net/omniscient?retryWrites=true&w=majority


# -----------------------------------------------------------------------------
# OPTIONAL: which sites may call this server
#
# During development leave this out and everything is allowed. In production
# list the exact address the app is served from, or anyone can call your API.
# -----------------------------------------------------------------------------
# ALLOWED_ORIGINS=https://your-app.vercel.app


# -----------------------------------------------------------------------------
# OPTIONAL: where the JSON file lives when there is no MongoDB
# -----------------------------------------------------------------------------
# DATA_FILE=./data/omniscient.json

# -----------------------------------------------------------------------------
# OPTIONAL: the port the backend listens on. Defaults to 3001.
# -----------------------------------------------------------------------------
# PORT=3001
